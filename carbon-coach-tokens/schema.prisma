// schema.prisma
// Data model for Carbon Coach's points/token system.
// Run: npx prisma migrate dev --name init_points_system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  displayName       String
  createdAt         DateTime         @default(now())

  // Denormalized running totals for fast dashboard reads.
  // Kept in sync by PointsEngine inside a transaction — never written directly elsewhere.
  totalPoints       Int              @default(0)
  totalCo2SavedKg   Float            @default(0)

  activities        CarbonActivity[]
  leaderboardWins   LeaderboardPrize[]
}

// One row per logged action that avoided/reduced emissions
// (e.g. biked instead of drove, took transit, avoided a flight, ate plant-based).
model CarbonActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  activityType    String   // e.g. "bike_commute", "transit", "plant_based_meal"
  co2SavedKg      Float    // computed by your emissions-estimation logic before this record is created
  pointsAwarded   Int      // computed by PointsEngine, stored for audit/history
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId, occurredAt])
}

// Snapshot of a monthly leaderboard period, so past months are queryable
// even after new activities push totals around.
model LeaderboardPeriod {
  id          String              @id @default(cuid())
  periodStart DateTime            // first day of the month, 00:00 UTC
  periodEnd   DateTime            // first day of next month, 00:00 UTC
  finalized   Boolean             @default(false) // true once prizes have been awarded
  prizes      LeaderboardPrize[]

  @@unique([periodStart, periodEnd])
}

model LeaderboardPrize {
  id          String              @id @default(cuid())
  periodId    String
  period      LeaderboardPeriod   @relation(fields: [periodId], references: [id])
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  rank        Int                 // 1, 2, or 3
  pointsAtWin Int
  prizeLabel  String              // e.g. "$25 gift card", "Free month premium"
  awardedAt   DateTime            @default(now())

  @@unique([periodId, rank])
}
